# Copy to report.env and fill values. Used by assemble-report.sh / prepare-submission.sh

SEVERITY=High
CATEGORY=UI
IMPACT=Chat interface freezes when opening share menu on Android.
ACCOUNT_EMAIL=user@example.com
SUBSCRIPTION_TIER=SuperGrokPro
PLATFORM=Android
SYSTEM_INFO=Pixel 8, Android 15, Grok app 1.2.3
DESCRIPTION=After the last update the share menu freezes the app for 10+ seconds.
STEPS=1. Open any chat. 2. Tap share. 3. Observe freeze.
